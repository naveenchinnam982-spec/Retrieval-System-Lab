<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/outline_light"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/surface_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_eval_item_rank"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:background="@drawable/ic_check"
                android:backgroundTint="@color/primary"
                android:text="#1"
                android:textColor="@color/on_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_eval_item_doc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Document.txt"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_background_light"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/tv_eval_item_sim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cosine Similarity: 0.8841"
                    android:textSize="11sp"
                    android:textColor="@color/secondary" />
            </LinearLayout>

            <!-- Toggle Relevance Chip -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_toggle_relevance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:checked="true"
                android:text="Relevant"
                android:textColor="#065F46"
                app:chipBackgroundColor="@color/status_success_container"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_eval_item_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Chunk content text excerpt..."
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.2"
            android:textColor="@color/on_surface_light" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
