<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Retrieval Evaluation Lab"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/on_background_light" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Test retrieval relevance and calculate Precision@K, Recall@K, Hit Rate@K, and MRR."
                android:textSize="13sp"
                android:textColor="@color/text_muted" />

            <!-- Preset Benchmark Queries -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="PRESET TEST QUERIES"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:textColor="@color/text_muted" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_eval_presets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_eval_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="What is machine learning?" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_eval_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="What are the advantages of neural networks?" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_eval_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Explain the attention mechanism." />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_eval_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="How does vector similarity retrieval work?" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Query Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_eval_query"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Enter evaluation query..."
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:endIconMode="clear_text"
                app:startIconDrawable="@drawable/ic_science"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_eval_query"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- K Selection & Run -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Top-K:"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface_light" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_eval_k"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_eval_k3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:checked="true"
                        android:text="3" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_eval_k5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="5" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_eval_k10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="10" />
                </com.google.android.material.chip.ChipGroup>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_run_evaluation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Run Test"
                    app:icon="@drawable/ic_science"
                    app:cornerRadius="10dp"
                    android:backgroundTint="@color/primary" />
            </LinearLayout>

            <!-- Loading Indicator -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_evaluation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <!-- Metrics Result Dashboard Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_eval_metrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/outline_light"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/surface_light"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RETRIEVAL EVALUATION METRICS"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:textColor="@color/secondary" />

                    <!-- 4 Metrics Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <!-- Precision@K -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_metric_precision"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1.00"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="@color/primary" />

                            <TextView
                                android:id="@+id/tv_label_precision"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Precision@3"
                                android:textSize="11sp"
                                android:textColor="@color/text_muted" />
                        </LinearLayout>

                        <!-- Recall@K -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_metric_recall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1.00"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="@color/secondary" />

                            <TextView
                                android:id="@+id/tv_label_recall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Recall@3"
                                android:textSize="11sp"
                                android:textColor="@color/text_muted" />
                        </LinearLayout>

                        <!-- Hit Rate@K -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_metric_hitrate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1.00"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="#059669" />

                            <TextView
                                android:id="@+id/tv_label_hitrate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hit Rate@3"
                                android:textSize="11sp"
                                android:textColor="@color/text_muted" />
                        </LinearLayout>

                        <!-- MRR -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_metric_mrr"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1.00"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="@color/tertiary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MRR"
                                android:textSize="11sp"
                                android:textColor="@color/text_muted" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Clarification Note Required by Requirement 13 -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/ic_check"
                        android:backgroundTint="@color/surface_variant_light"
                        android:padding="8dp"
                        android:text="Note: Relevance ground-truth is user-annotated. Toggle the 'Relevant' / 'Not Relevant' chips below to observe real-time metric updates."
                        android:textSize="11sp"
                        android:textColor="@color/text_muted" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Results List Header -->
            <TextView
                android:id="@+id/tv_eval_results_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="RETRIEVED CHUNKS &amp; RELEVANCE LABELS"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/text_muted"
                android:visibility="gone" />

            <!-- Empty Evaluation State -->
            <TextView
                android:id="@+id/tv_eval_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="Choose a preset query or type one above, then click 'Run Test'."
                android:textSize="14sp"
                android:textColor="@color/text_muted" />

            <!-- Chunks Evaluation List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_eval_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
