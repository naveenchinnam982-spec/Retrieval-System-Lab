<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/outline_light"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/surface_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header: Rank, Document Title, Similarity Score -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Rank Badge -->
            <TextView
                android:id="@+id/tv_result_rank"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:background="@drawable/ic_check"
                android:backgroundTint="@color/primary"
                android:text="#1"
                android:textColor="@color/on_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_result_doc_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI_Introduction.pdf"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_background_light"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/tv_result_chunk_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chunk #1 • Page 1 • 84 words"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <!-- Similarity Score Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_result_similarity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ic_check"
                    android:backgroundTint="@color/status_success_container"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="0.9124"
                    android:textColor="#065F46"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cosine Sim"
                    android:textSize="10sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@color/surface_variant_light" />

        <!-- Relevant Content Text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RELEVANT CONTENT:"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:textColor="@color/text_muted" />

        <TextView
            android:id="@+id/tv_result_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Machine learning is a field of artificial intelligence focused on building applications that learn from data..."
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.2"
            android:textColor="@color/on_surface_light" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
