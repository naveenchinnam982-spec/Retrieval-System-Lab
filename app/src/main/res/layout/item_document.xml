<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/outline_light"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/surface_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_doc_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_description"
                app:tint="@color/primary"
                android:contentDescription="Document" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_doc_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Document_Name.txt"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_background_light"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_doc_meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="3 Chunks • 384 dims • 4.2 KB"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_doc_type_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/ic_check"
                android:backgroundTint="@color/status_info_container"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="TXT"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/primary" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:background="@color/surface_variant_light" />

        <!-- Action Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_doc_view_chunks"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="View Chunks"
                android:textSize="12sp"
                app:icon="@drawable/ic_visibility"
                app:iconSize="16dp"
                style="@style/Widget.Material3.Button.TextButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_doc_search"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:text="Search"
                android:textSize="12sp"
                app:icon="@drawable/ic_search"
                app:iconSize="16dp"
                style="@style/Widget.Material3.Button.TextButton"
                android:textColor="@color/secondary" />

            <ImageButton
                android:id="@+id/btn_doc_delete"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete"
                app:tint="@color/status_error"
                android:contentDescription="Delete Document" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
