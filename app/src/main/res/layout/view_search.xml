<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Semantic Search"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/on_background_light" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Natural language retrieval using vector embedding similarity"
                android:textSize="13sp"
                android:textColor="@color/text_muted" />

            <!-- Query Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_search_query"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Enter natural-language search query..."
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:endIconMode="clear_text"
                app:startIconDrawable="@drawable/ic_search"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_search_query"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch"
                    android:inputType="textCapSentences"
                    android:maxLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Search Parameters Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/outline_light"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/surface_light">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Top-K Chips -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Top-K Results:"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/on_surface_light" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chip_group_top_k"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_k1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="true"
                                android:text="1" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_k3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="true"
                                android:checked="true"
                                android:text="3" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_k5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="true"
                                android:text="5" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_k10"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="true"
                                android:text="10" />
                        </com.google.android.material.chip.ChipGroup>
                    </LinearLayout>

                    <!-- Similarity Threshold Slider -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_threshold_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Min Similarity: 0.00"
                            android:textSize="13sp"
                            android:textColor="@color/text_muted" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/slider_threshold"
                            android:layout_width="160dp"
                            android:layout_height="wrap_content"
                            android:value="0.0"
                            android:valueFrom="0.0"
                            android:valueTo="0.80"
                            android:stepSize="0.05" />
                    </LinearLayout>

                    <!-- Document Scope Filter -->
                    <Spinner
                        android:id="@+id/spinner_doc_filter"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/ic_folder"
                        android:backgroundTint="@color/surface_variant_light" />

                    <!-- Search Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_run_search"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="12dp"
                        android:text="Retrieve Relevant Chunks"
                        app:icon="@drawable/ic_search"
                        app:cornerRadius="10dp"
                        android:backgroundTint="@color/primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Loading Indicator -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <!-- Search Stats Banner -->
            <TextView
                android:id="@+id/tv_search_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Retrieved 0 results"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_muted"
                android:visibility="gone" />

            <!-- Empty Search State -->
            <TextView
                android:id="@+id/tv_search_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="Enter a query above to retrieve relevant document chunks."
                android:textSize="14sp"
                android:textColor="@color/text_muted" />

            <!-- Search Results List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_search_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
