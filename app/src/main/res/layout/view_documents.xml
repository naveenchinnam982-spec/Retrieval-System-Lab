<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Action Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Document Library"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/on_background_light" />

            <TextView
                android:id="@+id/tv_doc_count_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 documents indexed"
                android:textSize="13sp"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_doc_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Import"
            app:icon="@drawable/ic_add"
            app:cornerRadius="10dp"
            android:textSize="13sp"
            android:backgroundTint="@color/primary" />
    </LinearLayout>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layout_empty_documents"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_folder"
            app:tint="@color/text_muted"
            android:contentDescription="Empty Folder" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="No Documents Indexed"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/on_background_light" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Import a PDF or TXT document, or load sample research papers to build your vector database."
            android:textSize="14sp"
            android:textColor="@color/text_muted" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_empty_load_benchmarks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Load 4 Benchmark Papers"
            app:icon="@drawable/ic_auto_stories"
            style="@style/Widget.Material3.Button.TonalButton" />
    </LinearLayout>

    <!-- Documents RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_documents"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

</LinearLayout>
